<?xml version="1.0" encoding="utf-8" standalone="yes"?>
<carrier_config_list>
    <!--
        Default config applied to every carrier unless overridden below.
        These values are applied on top of the AOSP CarrierConfig defaults.
    -->
    <carrier_config>
        <!-- Initial userspace MMTEL scope. -->
        <boolean name="carrier_volte_available_bool" value="true" />
        <boolean name="carrier_vt_available_bool" value="false" />
        <boolean name="imssms.sms_over_ims_supported_bool" value="true" />

        <!-- Make WFC availability deterministic. -->
        <boolean name="carrier_wfc_ims_available_bool" value="true" />
        <boolean name="carrier_wfc_supports_wifi_only_bool" value="true" />
        <boolean name="carrier_default_wfc_ims_enabled_bool" value="true" />
        <int name="carrier_default_wfc_ims_mode_int" value="2" />

        <!-- The open ImsMedia implementation has no EVS codec. -->
        <boolean name="imsvoice.audio_evs_support_bool" value="false" />

        <!-- The legacy data HAL needs break-before-make IMS switching. -->
        <boolean name="delay_ims_tear_down_until_call_end_bool" value="true" />

        <string-array name="iwlan_handover_policy_string_array" num="5">
            <item value="source=EUTRAN|NGRAN, target=IWLAN, type=disallowed, capabilities=IMS|EIMS" />
            <item value="source=IWLAN, target=EUTRAN|NGRAN, type=disallowed, capabilities=IMS|EIMS" />
            <item value="source=IWLAN, target=GERAN|UTRAN, type=disallowed" />
            <item value="source=GERAN|UTRAN, target=IWLAN, type=disallowed" />
            <item value="source=GERAN|UTRAN|EUTRAN|NGRAN|IWLAN|UNKNOWN, target=GERAN|UTRAN|EUTRAN|NGRAN|IWLAN, type=allowed" />
        </string-array>
    </carrier_config>

    <!--
        IR-MCI — Iran (MCC 432, MNC 11) — Tester 1
        Symptoms: VoLTE call connects but audio silently fails ("can't hear
        other side") due to audioserver crash. No IMS-specific overrides
        needed beyond the global ones; the audio fix handles this. Enabling
        carrier_volte_provisioned_bool=false prevents a provisioning check
        that can block IMS registration on some MCI SIM profiles.
    -->
    <carrier_config mcc="432" mnc="11">
        <boolean name="carrier_volte_available_bool" value="true" />
        <!-- Skip provisioning check; MCI does not provision via OMA-DM -->
        <boolean name="carrier_volte_provisioned_bool" value="false" />
        <boolean name="imsvoice.audio_evs_support_bool" value="false" />
    </carrier_config>

    <!--
        Entel Peru (MCC 716, MNC 17) — Tester 2
        Symptoms: VOPS_NOT_SUPPORTED reported at LTE attach time causes the
        device to skip VoLTE and attempt CSFB. On the second registration
        attempt IMS connects but the call drops at ~6 s with
        CODE_MEDIA_INIT_FAILED (401) due to the audio HAL hang.

        carrier_ignore_error_domain_registration_on_lte_bool=true tells
        ImsPhoneCallTracker to attempt IMS voice even when the network
        advertises VOPS=0, matching the behaviour of Samsung's stock firmware
        which also overrides VOPS for this carrier.

        carrier_volte_provisioned_bool=false avoids a provisioning timeout
        when Entel's IMS core does not respond to OMA-DM configuration.
    -->
    <carrier_config mcc="716" mnc="17">
        <boolean name="carrier_volte_available_bool" value="true" />
        <int-array name="ims.ims_pdn_enabled_in_no_vops_support_int_array" num="2">
            <item value="0" />
            <item value="1" />
        </int-array>
        <boolean name="carrier_volte_provisioned_bool" value="false" />
        <boolean name="imsvoice.audio_evs_support_bool" value="false" />
    </carrier_config>

    <!--
        Reliance Jio — India (MCC 405, MNC 840, 854-874)
        Pure LTE operator with no legacy CS (2G/3G) network.
        Authorize the IMS PDN without VoPS gating in DataNetworkController.
    -->
    <carrier_config mcc="405" mnc="840">
        <boolean name="carrier_volte_available_bool" value="true" />
        <boolean name="ims.request_ims_pdn_without_mmtel_bool" value="true" />
        <boolean name="ims.keep_pdn_up_in_no_vops_bool" value="true" />
        <int-array name="ims.ims_pdn_enabled_in_no_vops_support_int_array" num="2">
            <item value="0" />
            <item value="1" />
        </int-array>
        <boolean name="imsvoice.audio_evs_support_bool" value="false" />
    </carrier_config>

